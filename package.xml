<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vertex_one_description</name>
  <version>1.0.0</version>
  <description> Robot description models for the Avular Vertex One </description>
  <maintainer email="info@avular.com">Avular Robotics</maintainer>
  <license>Avular EULA</license>
  
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  
  <depend>robot_state_publisher</depend>
  
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  
  
  <export>
    <build_type>ament_cmake</build_type>
    <debian_depend>ros-humble-ament-cmake</debian_depend>

    <debian_depend>ros-humble-robot-state-publisher</debian_depend>

    <debian_depend>ros-humble-xacro</debian_depend>
  </export>
</package>
